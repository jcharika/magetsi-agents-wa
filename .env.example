APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── WhatsApp Cloud API — Agent Bot ──────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=magetsi_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── WhatsApp Cloud API — Customer Bot ───────
# Configure a separate phone number / WABA for the customer chatbot.
# The customer bot uses one single flow (resources/flows/customer.json)
# with all screens (ZESA, Airtime, Bundles, TelOne, Billers, Support).
# Webhook URL: https://yourdomain.com/api/customer/webhook
WHATSAPP_CUSTOMER_TOKEN=
WHATSAPP_CUSTOMER_PHONE_NUMBER_ID=
WHATSAPP_CUSTOMER_VERIFY_TOKEN=magetsi_customer_verify
WHATSAPP_CUSTOMER_BUSINESS_ACCOUNT_ID=
WHATSAPP_CUSTOMER_FLOW_ID=
WHATSAPP_CUSTOMER_FLOW_MODE=interactive
WHATSAPP_CUSTOMER_APP_SECRET=

# ── Customer Service Toggles ──────────────
# Set any service to "false" to hide it from the customer flow NavList.
WHATSAPP_CUSTOMER_SERVICE_ZESA=true
WHATSAPP_CUSTOMER_SERVICE_AIRTIME=true
WHATSAPP_CUSTOMER_SERVICE_BUNDLES=true
WHATSAPP_CUSTOMER_SERVICE_TELONE=true
WHATSAPP_CUSTOMER_SERVICE_BILLERS=true
WHATSAPP_CUSTOMER_SERVICE_SUPPORT=true

# ── WhatsApp Flow IDs — Agent Bot ──────────
# Agent bot uses separate flow IDs per product.
WHATSAPP_BUY_ZESA_FLOW_ID=
WHATSAPP_SETTINGS_FLOW_ID=

# Flow delivery: "interactive" (CTA in conversation) or "template" (pre-approved template)
WHATSAPP_FLOW_MODE=interactive

# Template names (only used when WHATSAPP_FLOW_MODE=template)
WHATSAPP_BUY_ZESA_TEMPLATE=buy_zesa_flow
WHATSAPP_SETTINGS_TEMPLATE=settings_flow
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Feature Flags ──────────────────────────
FLOWS_CUSTOMER_ENABLED=false

# ── WhatsApp Flows Encryption ──────────────
META_APP_SECRET=
WHATSAPP_FLOW_PRIVATE_KEY_PATH=
#WHATSAPP_FLOW_PRIVATE_KEY=

# ── Magetsi Backend ─────────────────────────
# Switch: "legacy" (legacy.magetsi.co.zw) or "new" (magetsi.co.zw)
MAGETSI_BACKEND=legacy

# New Backend API
MAGETSI_API_URL=https://magetsi.co.zw
MAGETSI_CHANNEL=AGENTS
MAGETSI_API_TIMEOUT=30
# Legacy Backend (legacy.magetsi.co.zw/api/zesa/v1)

MAGETSI_LEGACY_URL=https://legacy.magetsi.co.zw
MAGETSI_LEGACY_TOKEN=
MAGETSI_LEGACY_EMAIL=
MAGETSI_LEGACY_POLL_ATTEMPTS=10
MAGETSI_LEGACY_POLL_INTERVAL=3000
