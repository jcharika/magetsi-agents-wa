{
    "name": "magetsi/common",
    "description": "Shared code for Magetsi WhatsApp bots",
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "phpseclib/phpseclib": "^3.0",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "Magetsi\\Common\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Magetsi\\Common\\CommonServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
